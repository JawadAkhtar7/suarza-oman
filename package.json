{
  "name": "suarza-oman",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "demo": "turbo run demo dev --filter=@suarza-oman/api --filter=@suarza-oman/web",
    "share": "turbo run build --filter=@suarza-oman/web && SERVE_WEB=true pnpm --filter @suarza-oman/api start:built",
    "share:demo": "turbo run build --filter=@suarza-oman/web && pnpm --filter @suarza-oman/api demo:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
