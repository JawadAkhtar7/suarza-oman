# Copy to .env and fill in. .env is git-ignored; never commit a real URI.

# The Atlas connection string, including the database name at the end.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/suarza_oman?retryWrites=true&w=majority

PORT=4100

# Comma-separated origins allowed to call this API from a browser. The Vite dev
# server proxies /api, so in development nothing here is needed.
CORS_ORIGINS=
